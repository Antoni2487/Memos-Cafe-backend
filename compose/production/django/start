#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


python /app/manage.py collectstatic --noinput
python /app/manage.py migrate --noinput

# Railway (y otros PaaS) asignan su propio puerto via $PORT; se cae a 5000
# en local/docker-compose donde no se define esa variable.
exec gunicorn config.wsgi --bind "0.0.0.0:${PORT:-5000}" --chdir=/app
